{
  "name": "@ring/auth",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./Turnstile": {
      "import": "./dist/src/components/Turnstile.js",
      "require": "./dist/src/components/Turnstile.cjs"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint \"**/*.{ts,tsx,js,jsx}\"",
    "update-dependencies": "npx npm-check-updates -u"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.4.2"
  },
  "devDependencies": {
    "@ring/eslint-config": "*",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "sideEffects": false
}
