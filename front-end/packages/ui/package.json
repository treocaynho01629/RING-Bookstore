{
  "name": "@ring/ui",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ConfirmDialog": {
      "import": "./dist/src/components/ConfirmDialog.js",
      "require": "./dist/src/components/ConfirmDialog.cjs"
    },
    "./Components": {
      "import": "./dist/src/components/Components.js",
      "require": "./dist/src/components/Components.cjs"
    },
    "./DatePicker": {
      "import": "./dist/src/components/DatePicker.js",
      "require": "./dist/src/components/DatePicker.cjs"
    },
    "./LightboxImage": {
      "import": "./dist/src/components/LightboxImage.js",
      "require": "./dist/src/components/LightboxImage.cjs"
    },
    "./LightboxImages": {
      "import": "./dist/src/components/LightboxImages.js",
      "require": "./dist/src/components/LightboxImages.cjs"
    },
    "./PasswordInput": {
      "import": "./dist/src/components/PasswordInput.js",
      "require": "./dist/src/components/PasswordInput.cjs"
    },
    "./Placeholder": {
      "import": "./dist/src/components/Placeholder.js",
      "require": "./dist/src/components/Placeholder.cjs"
    },
    "./Progress": {
      "import": "./dist/src/components/Progress.js",
      "require": "./dist/src/components/Progress.cjs"
    },
    "./Snackbar": {
      "import": "./dist/src/components/Snackbar.js",
      "require": "./dist/src/components/Snackbar.cjs"
    },
    "./CustomSlider": {
      "import": "./dist/src/components/CustomSlider.js",
      "require": "./dist/src/components/CustomSlider.cjs"
    },
    "./FallbackLogo": {
      "import": "./dist/src/layout/FallbackLogo.js",
      "require": "./dist/src/layout/FallbackLogo.cjs"
    },
    "./PendingModal": {
      "import": "./dist/src/layout/PendingModal.js",
      "require": "./dist/src/layout/PendingModal.cjs"
    },
    "./theme": {
      "import": "./dist/src/lib/theme.js",
      "require": "./dist/src/lib/theme.cjs"
    },
    "./SnackbarProvider": {
      "import": "./dist/src/provider/SnackbarProvider.js",
      "require": "./dist/src/provider/SnackbarProvider.cjs"
    },
    "./ThemeContextProvider": {
      "import": "./dist/src/provider/ThemeContextProvider.js",
      "require": "./dist/src/provider/ThemeContextProvider.cjs"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint \"**/*.{ts,tsx,js,jsx}\"",
    "update-dependencies": "npx npm-check-updates -u"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "notistack": "^3.0.2",
    "react": "^18.0.0 || ^19.0.0",
    "react-multi-carousel": "^2.8.6"
  },
  "dependencies": {
    "@mui/x-date-pickers": "^8.27.2",
    "@ring/shared": "*",
    "dayjs": "^1.11.20",
    "react-lazy-load-image-component": "^1.6.3",
    "yet-another-react-lightbox": "^3.29.2"
  },
  "devDependencies": {
    "@ring/eslint-config": "*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  },
  "sideEffects": false
}
